APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Waktu untuk log Laravel, Carbon, dll. Contoh Indonesia: Asia/Jakarta
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

AGENT_ENROLLMENT_KEY=change-me-agent-enrollment
AGENT_OFFLINE_AFTER_MINUTES=5
AGENT_DEFAULT_INTERVAL=30
AGENT_METRIC_RETENTION_DAYS=7
# Database Utama (Portal Sifast)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Database Kedua (SIMRS Khanza - dbsimrs)
# DB_HOST_2=127.0.0.1
# DB_PORT_2=3306
# DB_DATABASE_2=db_khanza_simrs
# DB_USERNAME_2=root
# DB_PASSWORD_2=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS: origin frontend yang boleh akses API (domain lain). Pisahkan dengan koma. Jangan pakai spasi.
# Contoh: https://sifast.rsasf.web.id,https://preview--panic-safe-spot.lovable.app
CORS_ALLOWED_ORIGINS=

# Sanctum: domain frontend yang boleh kirim cookie (untuk SPA stateful). Pisahkan dengan koma.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Telegram Bot (notifikasi tiket + catatan dari Telegram). Buat bot via @BotFather, isi token & username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Chat ID grup untuk broadcast tiket baru (semua teknisi). Bot harus jadi anggota grup. Contoh: -1001234567890
TELEGRAM_TICKETS_GROUP_CHAT_ID=

# Daftar email superadmin (boleh mengatur siapa yang bisa akses payroll), pisahkan koma.
AUTH_SUPERADMIN_EMAILS=

# Email yang boleh mengatur flag SIMMUTU per user (selain superadmin), pisahkan koma.
AUTH_SIMMUTU_FLAG_MANAGERS=

# Integrasi SSO ke SIKAT legacy (Surat Menyurat). Secret harus sama dengan SIKAT.
SIKAT_BASE_URL=https://sikat.rsaisyiyahsitifatimah.com
PORTALSIFAST_SIKAT_SSO_SECRET=
SIKAT_SSO_TOKEN_TTL=90

# Instagram feed untuk website official (Instagram Business + Graph API)
INSTAGRAM_FEED_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_PROFILE_URL=https://instagram.com/rsasitifatimah
INSTAGRAM_FEED_LIMIT=12
INSTAGRAM_FEED_CACHE_MINUTES=60
INSTAGRAM_GRAPH_API_VERSION=v21.0

# Berita RSS eksternal (Muhammadiyah, Suara Muhammadiyah, dll.)
EXTERNAL_RSS_ENABLED=true
EXTERNAL_RSS_DEFAULT_LIMIT=20
EXTERNAL_RSS_CACHE_MINUTES=60
EXTERNAL_RSS_SUARA_URL=https://web.suaramuhammadiyah.id/feed/
EXTERNAL_RSS_SUARA_WEBSITE=https://suaramuhammadiyah.id
EXTERNAL_RSS_MUHAMMADIYAH_URL=https://muhammadiyah.or.id/feed/
EXTERNAL_RSS_MUHAMMADIYAH_WEBSITE=https://muhammadiyah.or.id

# Base URL foto inventaris SIMRS (diambil server-side → base64 ke browser)
SIMRS_INVENTARIS_ASSET_BASE_URL=http://192.168.10.3/webapps2/inventaris

TIANJI_BASE_URL=
TIANJI_API_KEY=
TIANJI_WORKSPACE_ID=
TIANJI_TIMEOUT=30
